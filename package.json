{
  "name": "delightful-labs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "pnpm --filter delightful-labs dev",
    "build": "pnpm --filter delightful-labs build",
    "preview": "pnpm --filter delightful-labs preview",
    "check": "pnpm --filter delightful-labs check",
    "test": "pnpm --filter delightful-labs test",
    "test:browser": "pnpm --filter delightful-labs test:browser",
    "test:build": "pnpm --filter delightful-labs test:build",
    "monorepo:inventory": "node scripts/monorepo/inventory.mjs",
    "ui:check": "pnpm --filter delightful-ui check",
    "ui:package": "pnpm --filter delightful-ui package",
    "ui:test": "pnpm --filter delightful-ui test:unit --run",
    "ui:build": "pnpm --filter delightful-ui build",
    "dlf:check": "pnpm --filter delightful-local-first check:library",
    "dlf:package": "pnpm --filter delightful-local-first package",
    "dlf:test": "pnpm --filter delightful-local-first test:unit --run",
    "dlf:verify": "pnpm --filter delightful-local-first verify",
    "build:libraries": "pnpm ui:package && pnpm dlf:package",
    "finance:dev": "pnpm --filter delightful-finances dev",
    "finance:check": "pnpm --filter delightful-finances check",
    "finance:test": "pnpm --filter delightful-finances test:unit --run",
    "finance:build": "pnpm --filter delightful-finances build",
    "finance:test:worker-state": "pnpm --filter delightful-finances test:worker-state",
    "finance:test:worker-host": "pnpm --filter delightful-finances test:worker-host",
    "clipper:dev": "pnpm --filter delightful-clipper dev",
    "clipper:check": "pnpm --filter delightful-clipper check",
    "clipper:test": "pnpm --filter delightful-clipper test:unit",
    "clipper:build": "pnpm --filter delightful-clipper build",
    "clipper:verify": "pnpm --filter delightful-clipper verify",
    "clipper:build:extension": "pnpm --filter delightful-clipper build:extension",
    "clipper:test:worker": "pnpm --filter delightful-clipper test:worker",
    "clipper:test:offline": "pnpm --filter delightful-clipper test:offline",
    "clipper:test:extension": "pnpm --filter delightful-clipper test:extension",
    "clipper:test:e2e": "pnpm --filter delightful-clipper test:e2e",
    "monorepo:check-links": "node scripts/monorepo/check-links.mjs",
    "monorepo:check-guidance": "node scripts/monorepo/check-guidance.mjs",
    "monorepo:test-tooling": "node --test scripts/monorepo/ci.test.mjs scripts/monorepo/guidance.test.mjs"
  }
}
